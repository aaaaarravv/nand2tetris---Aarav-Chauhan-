// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    Nand(a=a , b=a , out=nand1out );

    Nand(a=nand1out, b=b , out=nand2out );

    

    Nand(a=a , b=nand4out , out=nand3out );  

    Nand(a=b , b=b , out=nand4out );



    Nand(a=nand2out , b=nand3out , out=out );
}